def get_color_score_pair_dict(ball_score_list):
    color_score_pair_list = {}
    for item in ball_score_list:
        pairs = item.split(":")
        color, score = pairs[0], int(pairs[1])
        if color in color_score_pair_list:
            color_score_pair_list[color] = color_score_pair_list[color] + score
        else:
            color_score_pair_list[color] = score 
    return color_score_pair_list
ball_score_list = input().split(",")
color_score_pair_dict = get_color_score_pair_dict(ball_score_list)
listed_color_pairs = color_score_pair_dict.items()
accending_order = sorted(listed_color_pairs)
print(accending_order)

def convert_string_to_int(list_a):
    new_list = []
    for item in list_a:
        num = int(item)
        new_list.append(num)
    return new_list

m, n = input().split()
m, n = int(m), int(n)
num_list = []

for i in range(m):
    list_a = input().split()
    list_a = convert_string_to_int(list_a)
    num_list.append(list_a)
max_val = []
min_val = []
sum_val = []
for row in num_list:
    max_val.append(max(row))
    min_val.append(min(row))
    sum_val.append(sum(row))
print(max(max_val))
print(min(min_val))
print(sum(sum_val))
